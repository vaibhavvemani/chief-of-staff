    "modules": [
      {
        "id": "m1",
        "order": 1,
        "title": "Foundations of Financial Risk",
        "context": {
          "purpose": "Establish the concepts, classifications, process, appetite, history, and governance foundations needed for later risk analysis.",
          "in_scope": [
            "financial-risk foundations",
            "institutional risk context"
          ],
          "out_of_scope": [
            "detailed quantitative model implementation"
          ]
        },
        "prerequisite_module_ids": [],
        "subtopics": [
          {
            "id": "m1_s1",
            "order": 1,
            "title": "Nature of Financial Risk",
            "context": {
              "purpose": "Introduce financial risk, distinguish measurable risk from uncertainty, explain four core risk categories, and show how they interact in a crisis.",
              "in_scope": [
                "risk versus uncertainty",
                "credit risk",
                "liquidity risk",
                "market risk",
                "operational risk",
                "layered risk",
                "Lehman Brothers illustration"
              ],
              "out_of_scope": [
                "formal risk taxonomy",
                "risk-management lifecycle",
                "risk-appetite design",
                "governance-structure design"
              ]
            },
            "prerequisite_subtopic_ids": [],
            "concepts": [
              {
                "id": "c1",
                "name": "Financial Risk",
                "summary": "The possibility of loss arising from exposure to market movements, counterparty default, funding shortfalls, or operational failure.",
                "depends_on": [],
                "source_ids": []
              },
              {
                "id": "c2",
                "name": "Risk vs Uncertainty",
                "summary": "Knight distinguishes measurable risk from uncertainty that cannot be assigned reliable probabilities; quantitative risk management mainly operates in the measurable zone.",
                "depends_on": [
                  "c1"
                ],
                "source_ids": [
                  "g1"
                ]
              },
              {
                "id": "c3",
                "name": "Credit Risk",
                "summary": "The potential that a borrower or counterparty fails to meet agreed obligations across loans, securities, derivatives, guarantees, or settlement activity.",
                "depends_on": [
                  "c1"
                ],
                "source_ids": [
                  "g2"
                ]
              },
              {
                "id": "c4",
                "name": "Liquidity Risk",
                "summary": "The risk that an institution cannot fund assets or meet obligations when due without unacceptable losses, even when it appears solvent.",
                "depends_on": [
                  "c1"
                ],
                "source_ids": [
                  "g3"
                ]
              },
              {
                "id": "c5",
                "name": "Market Risk",
                "summary": "The risk of loss from movements in factors such as interest rates, foreign exchange, credit spreads, equities, commodities, and volatility.",
                "depends_on": [
                  "c1"
                ],
                "source_ids": [
                  "g4"
                ]
              },
              {
                "id": "c6",
                "name": "Operational Risk",
                "summary": "The risk of loss from failed processes, people, systems, or external events, commonly including legal risk.",
                "depends_on": [
                  "c1"
                ],
                "source_ids": [
                  "g4"
                ]
              },
              {
                "id": "c7",
                "name": "Layered Risk",
                "summary": "Risk categories interact: a shock in one category can amplify others, especially when liquidity stress forces asset sales and worsens solvency concerns.",
                "depends_on": [
                  "c3",
                  "c4",
                  "c5",
                  "c6"
                ],
                "source_ids": [
                  "g2",
                  "g3",
                  "g5"
                ]
              },
              {
                "id": "c8",
                "name": "Measurement Enables Management",
                "summary": "Models and controls require estimates of probability, exposure, or impact; judgment remains essential where uncertainty cannot be modeled reliably.",
                "depends_on": [
                  "c2"
                ],
                "source_ids": [
                  "g1"
                ]
              }
            ],
            "coverage_requirements": [
              {
                "id": "cr1",
                "statement": "Define financial risk and distinguish measurable risk from Knightian uncertainty, including why the distinction matters for management tools.",
                "concept_ids": [
                  "c1",
                  "c2",
                  "c8"
                ],
                "source_ids": [
                  "g1"
                ]
              },
              {
                "id": "cr2",
                "statement": "Explain credit risk and show that counterparty exposure extends beyond ordinary loans.",
                "concept_ids": [
                  "c3"
                ],
                "source_ids": [
                  "g2"
                ]
              },
              {
                "id": "cr3",
                "statement": "Explain liquidity risk and why a solvent-looking institution can fail when funding disappears.",
                "concept_ids": [
                  "c4"
                ],
                "source_ids": [
                  "g3"
                ]
              },
              {
                "id": "cr4",
                "statement": "Define and contrast market risk and operational risk using representative exposure and failure examples.",
                "concept_ids": [
                  "c5",
                  "c6"
                ],
                "source_ids": [
                  "g4"
                ]
              },
              {
                "id": "cr5",
                "statement": "Explain how credit, liquidity, market, and operational risks can interact and amplify one another.",
                "concept_ids": [
                  "c3",
                  "c4",
                  "c5",
                  "c6",
                  "c7"
                ],
                "source_ids": [
                  "g2",
                  "g3",
                  "g5"
                ]
              },
              {
                "id": "cr6",
                "statement": "Use the Lehman Brothers collapse as a grounded illustration of layered market, funding, solvency, and governance pressures.",
                "concept_ids": [
                  "c7"
                ],
                "source_ids": [
                  "g5"
                ]
              }
            ],
            "approved_source_ids": [
              "g1",
              "g2",
              "g3",
              "g4",
              "g5",
              "g6"
            ]
