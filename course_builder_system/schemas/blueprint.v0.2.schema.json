{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course-builder.local/schemas/blueprint.v0.2.schema.json",
  "title": "Course Builder Blueprint v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course_id",
    "artifact_type",
    "produced_by_step",
    "schema_version",
    "status",
    "revision",
    "revision_note",
    "inputs",
    "updated_at",
    "body"
  ],
  "properties": {
    "course_id": { "$ref": "#/$defs/id" },
    "artifact_type": { "const": "blueprint" },
    "produced_by_step": { "enum": ["blueprint", "human"] },
    "schema_version": { "const": "0.2" },
    "status": { "enum": ["draft", "in_review", "approved", "rejected"] },
    "revision": { "type": "integer", "minimum": 0 },
    "revision_note": { "type": ["string", "null"], "maxLength": 500 },
    "inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": "course_model" },
      "uniqueItems": true
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "body": { "$ref": "#/$defs/body" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "id_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "word_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "target", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    },
    "depth_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "target_learning_minutes",
        "target_word_range",
        "required_concept_ids",
        "required_example_count",
        "case_depth",
        "assessment_complexity",
        "expansion_policy"
      ],
      "properties": {
        "level": { "enum": ["introductory", "intermediate", "advanced", "custom"] },
        "target_learning_minutes": { "type": "integer", "minimum": 1 },
        "target_word_range": { "$ref": "#/$defs/word_range" },
        "required_concept_ids": { "$ref": "#/$defs/id_list" },
        "required_example_count": { "type": "integer", "minimum": 0 },
        "case_depth": { "enum": ["none", "brief", "detailed"] },
        "assessment_complexity": { "enum": ["none", "recall", "application", "analysis"] },
        "expansion_policy": { "const": "targeted_by_coverage_gap" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_type",
        "title",
        "format",
        "selection_status",
        "purpose",
        "source_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "asset_type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "format": { "type": "string", "minLength": 1, "maxLength": 50 },
        "selection_status": { "enum": ["proposed", "selected", "rejected"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "subtopic_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtopic_id",
        "depth_budget",
        "asset_plan",
        "source_routing_notes",
        "anchor_asset_waiver_confirmed"
      ],
      "properties": {
        "subtopic_id": { "$ref": "#/$defs/id" },
        "depth_budget": { "$ref": "#/$defs/depth_budget" },
        "asset_plan": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/asset" }
        },
        "source_routing_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "anchor_asset_waiver_confirmed": { "type": "boolean" }
      }
    },
    "course_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth_budget", "default_asset_types", "source_routing_policy"],
      "properties": {
        "depth_budget": { "$ref": "#/$defs/depth_budget" },
        "default_asset_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        },
        "source_routing_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "decision_log_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "decision", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 200 },
        "decision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_defaults", "subtopic_plans", "decision_log"],
      "properties": {
        "course_defaults": { "$ref": "#/$defs/course_defaults" },
        "subtopic_plans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subtopic_plan" }
        },
        "decision_log": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision_log_item" }
        }
      }
    }
  }
}
