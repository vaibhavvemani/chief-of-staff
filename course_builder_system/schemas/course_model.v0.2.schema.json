{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course-builder.local/schemas/course_model.v0.2.schema.json",
  "title": "Course Builder Combined Course Model v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course_id",
    "artifact_type",
    "produced_by_step",
    "schema_version",
    "status",
    "revision",
    "revision_note",
    "inputs",
    "updated_at",
    "body"
  ],
  "properties": {
    "course_id": { "$ref": "#/$defs/id" },
    "artifact_type": { "const": "course_model" },
    "produced_by_step": { "enum": ["structure", "human"] },
    "schema_version": { "const": "0.2" },
    "status": { "enum": ["draft", "in_review", "approved", "rejected"] },
    "revision": { "type": "integer", "minimum": 0 },
    "revision_note": { "type": ["string", "null"], "maxLength": 500 },
    "inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": "course_outcomes" },
      "uniqueItems": true
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "body": { "$ref": "#/$defs/body" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "compact_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "id_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "in_scope", "out_of_scope"],
      "properties": {
        "purpose": { "$ref": "#/$defs/compact_text" },
        "in_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 180 },
          "uniqueItems": true
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 180 },
          "uniqueItems": true
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "depends_on", "source_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "depends_on": { "$ref": "#/$defs/id_list" },
        "source_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "coverage_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "concept_ids", "source_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 300 },
        "concept_ids": { "$ref": "#/$defs/id_list" },
        "source_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "subtopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "context",
        "prerequisite_subtopic_ids",
        "concepts",
        "coverage_requirements",
        "approved_source_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "context": { "$ref": "#/$defs/context" },
        "prerequisite_subtopic_ids": { "$ref": "#/$defs/id_list" },
        "concepts": {
          "type": "array",
          "items": { "$ref": "#/$defs/concept" }
        },
        "coverage_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_requirement" }
        },
        "approved_source_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "context",
        "prerequisite_module_ids",
        "subtopics"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "context": { "$ref": "#/$defs/context" },
        "prerequisite_module_ids": { "$ref": "#/$defs/id_list" },
        "subtopics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subtopic" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "source_type",
        "locator",
        "content_ref"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "locator": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "content_ref": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_title",
        "subject",
        "audience_summary",
        "level",
        "language",
        "jurisdiction",
        "course_outcome_ids"
      ],
      "properties": {
        "course_title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "audience_summary": { "$ref": "#/$defs/compact_text" },
        "level": { "type": "string", "minLength": 1, "maxLength": 100 },
        "language": { "type": "string", "minLength": 1, "maxLength": 100 },
        "jurisdiction": { "type": ["string", "null"], "maxLength": 200 },
        "course_outcome_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_metadata", "modules", "source_registry"],
      "properties": {
        "course_metadata": { "$ref": "#/$defs/metadata" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/module" }
        },
        "source_registry": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
